*.bak
*.tmp
*.temp
*.log
*.orig
*.rej
.cache/
tmp/
temp/

# ─────────────────────────────────────────────
#  Секреты — на всякий случай, репозиторий публичный
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets.*
credentials.*

