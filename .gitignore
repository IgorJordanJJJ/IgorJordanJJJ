.idea/
*.iml
*.ipr
*.iws
out/
cmake-build-*/

# Visual Studio Code
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse / NetBeans
.classpath
.project
.settings/
nbproject/

# Vim / Emacs / прочие редакторы
*.swp
*.swo
*~
.*.sw[a-z]
\#*\#
.\#*

# ─────────────────────────────────────────────
#  Системные файлы ОС
# ─────────────────────────────────────────────

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.fuse_hidden*

# ─────────────────────────────────────────────
#  Временные и служебные файлы
